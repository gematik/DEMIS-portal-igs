{
  "name": "portal-igs",
  "version": "1.4.4-snapshot",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4204",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "clean-cache": "rimraf .angular/cache && echo Cache cleared - next build will be slower but clean",
    "build-fresh": "npm run clean-cache && npm run build",
    "test": "vitest run --coverage && npm run fix-junit-time",
    "test-local": "vitest",
    "test-local-browser": "vitest --browser.headless=false",
    "fix-junit-time": "node scripts/fix-junit-time.mjs",
    "docker": "docker build -t europe-west3-docker.pkg.dev/gematik-all-infra-prod/demis-dev/portal-igs:latest .",
    "build:single-spa:portal-igs": "ng build portal-igs --configuration production",
    "serve:single-spa:portal-igs": "ng s --project portal-igs --disable-host-check --port 4204 --live-reload false"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/material": "21.2.14",
    "@angular/material-date-fns-adapter": "21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@gematik/demis-portal-core-library": "4.2.10",
    "@ngx-formly/core": "7.1.0",
    "@ngx-formly/material": "7.1.0",
    "date-fns": "4.4.0",
    "export-to-csv": "1.4.0",
    "marked": "17.0.1",
    "ngx-logger": "5.0.12",
    "ngx-mat-select-search": "8.0.6",
    "rxjs": "7.8.2",
    "single-spa": "6.0.3",
    "single-spa-angular": "21.0.2",
    "systemjs-webpack-interop": "2.3.7",
    "tslib": "2.8.1",
    "uuid": "14.0.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-builders/custom-webpack": "21.0.3",
    "@angular-eslint/builder": "21.2.0",
    "@angular-eslint/eslint-plugin": "21.2.0",
    "@angular-eslint/eslint-plugin-template": "21.2.0",
    "@angular-eslint/schematics": "21.2.0",
    "@angular-eslint/template-parser": "21.2.0",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@types/node": "25.2.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "ng-mocks": "14.15.3",
    "playwright": "1.61.1",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "style-loader": "3.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.27.3": true
  }
